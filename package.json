{
  "name": "@isonia/app-core",
  "version": "0.8.0-alpha.4",
  "description": "Public self-hostable governance console foundation for IsoniaOS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "node scripts/typecheck-app.mjs --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "node scripts/test-address-utils.mjs && node scripts/test-proposal-route-display.mjs && node scripts/test-proposal-execution-boundary.mjs && node scripts/test-accountability-display.mjs",
    "test:accountability-display": "node scripts/test-accountability-display.mjs",
    "test:address": "node scripts/test-address-utils.mjs",
    "test:proposal-execution-boundary": "node scripts/test-proposal-execution-boundary.mjs",
    "test:proposal-route-display": "node scripts/test-proposal-route-display.mjs",
    "typecheck": "node scripts/typecheck-app.mjs --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@chakra-ui/react": "3.35.0",
    "@dicebear/collection": "9.4.2",
    "@dicebear/core": "9.4.2",
    "@emotion/react": "11.14.0",
    "@hugeicons/core-free-icons": "4.1.2",
    "@hugeicons/react": "1.1.6",
    "@isonia/sdk": "github:isoniaos/sdk#v0.8.0-alpha.4",
    "@isonia/theme-default": "github:isoniaos/theme-default#v0.6.0-alpha.3",
    "@isonia/types": "github:isoniaos/types#v0.8.0-alpha.4",
    "@reown/appkit": "1.8.19",
    "@reown/appkit-adapter-wagmi": "1.8.19",
    "@tanstack/react-query": "5.100.5",
    "@xyflow/react": "12.10.2",
    "next-themes": "0.4.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.14.2",
    "viem": "2.48.4",
    "wagmi": "3.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.18.0",
    "globals": "16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.10"
  }
}
